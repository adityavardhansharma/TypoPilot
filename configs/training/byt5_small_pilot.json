{
  "experiment_name": "byt5-small-pilot-001",
  "model_name": "google/byt5-small",
  "train_file": "data/pilot/train.jsonl",
  "val_file": "data/pilot/val.jsonl",
  "output_dir": "experiments/byt5-small-pilot-001",

  "max_input_bytes": 192,
  "max_target_bytes": 192,

  "per_device_train_batch_size": 2,
  "gradient_accumulation_steps": 8,
  "learning_rate": 3e-4,
  "num_train_epochs": 3,
  "warmup_ratio": 0.03,
  "weight_decay": 0.01,
  "lr_scheduler_type": "linear",

  "fp32_note": "T5-family models produce NaN losses in fp16 and this GPU (GTX 1660 Ti, Turing) has no bf16, so training runs in full fp32.",
  "gradient_checkpointing": true,

  "eval_steps": 250,
  "save_steps": 250,
  "save_total_limit": 2,
  "logging_steps": 25,
  "seed": 13
}
