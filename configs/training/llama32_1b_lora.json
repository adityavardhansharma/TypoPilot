{
  "experiment_name": "llama32-1b-lora-001",
  "model_name": "unsloth/Llama-3.2-1B-Instruct",
  "model_note": "Ungated mirror of meta-llama/Llama-3.2-1B-Instruct (avoids HF gating). To use Meta's original, set HF_TOKEN and change this to meta-llama/Llama-3.2-1B-Instruct.",
  "train_file": "data/final_250k/train.jsonl",
  "val_file": "data/final_250k/val_2500.jsonl",
  "output_dir": "experiments/llama32-1b-lora-001",

  "max_seq_len": 256,

  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "lora_target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],

  "per_device_train_batch_size": 32,
  "gradient_accumulation_steps": 1,
  "learning_rate": 2e-4,
  "num_train_epochs": 2.0,
  "warmup_ratio": 0.03,
  "weight_decay": 0.0,
  "lr_scheduler_type": "cosine",

  "bf16": true,
  "fp16": false,
  "precision_note": "bf16 for L40S/Ampere+. On a T4 (Kaggle/Colab, no bf16) set bf16=false and fp16=true.",
  "gradient_checkpointing": false,

  "eval_steps": 1000,
  "save_steps": 1000,
  "save_total_limit": 2,
  "logging_steps": 25,
  "seed": 41
}
